[Unit]
Description=ad-manager — Active Directory management web panel
Documentation=https://github.com/jniltinho/ad-manager
After=network-online.target samba-ad-dc.service redis-server.service
Wants=network-online.target

[Service]
User=ad-manager
Group=ad-manager
# adm: read-only access to /var/log/samba (Logs page → Samba)
SupplementaryGroups=adm
EnvironmentFile=-/opt/ad-manager/env
ExecStart=/opt/ad-manager/ad-manager server --config /opt/ad-manager/config.toml
Restart=on-failure
# operator credentials live only in memory: no core dumps
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# everything lives in /opt/ad-manager; only data and logs are writable
ReadWritePaths=/opt/ad-manager/data /opt/ad-manager/logs
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
