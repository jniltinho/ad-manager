            "text": "[{\"dn\":\"CN=Remote Desktop Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Remote Desktop Users\",\"sid\":\"S-1-5-32-555\",\"description\":\"Members in this group are granted the right to logon remotely\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Performance Log Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Performance Log Users\",\"sid\":\"S-1-5-32-559\",\"description\":\"Members of this group may schedule logging of performance counters, enable trace providers, and collect event traces both locally and via remote access to this computer\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Suporte,CN=Users,DC=empresa,DC=test\",\"name\":\"Suporte\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1118\",\"description\":\"Equipe Suporte\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":2},{\"dn\":\"CN=Domain Users,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Users\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-513\",\"description\":\"All domain users\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Protected Users,CN=Users,DC=empresa,DC=test\",\"name\":\"Protected Users\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-525\",\"description\":\"Members of this group are afforded additional protections against authentication security threats\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Cryptographic Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Cryptographic Operators\",\"sid\":\"S-1-5-32-569\",\"description\":\"Members are authorized to perform cryptographic operations.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Design,CN=Users,DC=empresa,DC=test\",\"name\":\"Design\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1119\",\"description\":\"Equipe Design\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Diretoria,CN=Users,DC=empresa,DC=test\",\"name\":\"Diretoria\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1117\",\"description\":\"Equipe Diretoria\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Pre-Windows 2000 Compatible Access,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Pre-Windows 2000 Compatible Access\",\"sid\":\"S-1-5-32-554\",\"description\":\"A backward compatibility group which allows read access on all users and groups in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=DnsUpdateProxy,CN=Users,DC=empresa,DC=test\",\"name\":\"DnsUpdateProxy\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1102\",\"description\":\"DNS clients who are permitted to perform dynamic updates on behalf of some other clients (such as DHCP servers).\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Allowed RODC Password Replication Group,CN=Users,DC=empresa,DC=test\",\"name\":\"Allowed RODC Password Replication Group\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-571\",\"description\":\"Members in this group can have their passwords replicated to all read-only domain controllers in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Domain Computers,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Computers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-515\",\"description\":\"All workstations and servers joined to the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Incoming Forest Trust Builders,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Incoming Forest Trust Builders\",\"sid\":\"S-1-5-32-557\",\"description\":\"Members of this group can create incoming, one-way trusts to this forest\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=DnsAdmins,CN=Users,DC=empresa,DC=test\",\"name\":\"DnsAdmins\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1101\",\"description\":\"DNS Administrators Group\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":false,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Cert Publishers,CN=Users,DC=empresa,DC=test\",\"name\":\"Cert Publishers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-517\",\"description\":\"Members of this group are permitted to publish certificates to the directory\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Account Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Account Operators\",\"sid\":\"S-1-5-32-548\",\"description\":\"Members can administer domain user and group accounts\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Terminal Server License Servers,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Terminal Server License Servers\",\"sid\":\"S-1-5-32-561\",\"description\":\"Members of this group can update user accounts in Active Directory with information about license issuance, for the purpose of tracking and reporting TS Per User CAL usage\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Replicator,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Replicator\",\"sid\":\"S-1-5-32-552\",\"description\":\"Supports file replication in a domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Read-only Domain Controllers,CN=Users,DC=empresa,DC=test\",\"name\":\"Read-only Domain Controllers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-521\",\"description\":\"Members of this group are Read-Only Domain Controllers in the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Administrators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Administrators\",\"sid\":\"S-1-5-32-544\",\"description\":\"Administrators have complete and unrestricted access to the computer/domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":3},{\"dn\":\"CN=Server Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Server Operators\",\"sid\":\"S-1-5-32-549\",\"description\":\"Members can administer domain servers\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Network Configuration Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Network Configuration Operators\",\"sid\":\"S-1-5-32-556\",\"description\":\"Members in this group can have some administrative privileges to manage configuration of networking features\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Financeiro,CN=Users,DC=empresa,DC=test\",\"name\":\"Financeiro\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1115\",\"description\":\"Equipe Financeiro\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":2},{\"dn\":\"CN=Domain Admins,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Admins\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-512\",\"description\":\"Designated administrators of the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":2},{\"dn\":\"CN=Certificate Service DCOM Access,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Certificate Service DCOM Access\",\"sid\":\"S-1-5-32-574\",\"description\":\"Members of this group are allowed to connect to Certification Authorities in the enterprise\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Comercial,CN=Users,DC=empresa,DC=test\",\"name\":\"Comercial\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1116\",\"description\":\"Equipe Comercial\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":2},{\"dn\":\"CN=Event Log Readers,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Event Log Readers\",\"sid\":\"S-1-5-32-573\",\"description\":\"Members of this group can read event logs from local machine\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Performance Monitor Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Performance Monitor Users\",\"sid\":\"S-1-5-32-558\",\"description\":\"Members of this group can access performance counter data locally and remotely\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Users\",\"sid\":\"S-1-5-32-545\",\"description\":\"Users are prevented from making accidental or intentional system-wide changes and can run most applications\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":3},{\"dn\":\"CN=Enterprise Admins,CN=Users,DC=empresa,DC=test\",\"name\":\"Enterprise Admins\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-519\",\"description\":\"Designated administrators of the enterprise\",\"type\":\"security\",\"scope\":\"universal\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Print Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Print Operators\",\"sid\":\"S-1-5-32-550\",\"description\":\"Members can administer domain printers\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Schema Admins,CN=Users,DC=empresa,DC=test\",\"name\":\"Schema Admins\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-518\",\"description\":\"Designated administrators of the schema\",\"type\":\"security\",\"scope\":\"universal\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Backup Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Backup Operators\",\"sid\":\"S-1-5-32-551\",\"description\":\"Backup Operators can override security restrictions for the sole purpose of backing up or restoring files\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Group Policy Creator Owners,CN=Users,DC=empresa,DC=test\",\"name\":\"Group Policy Creator Owners\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-520\",\"description\":\"Members in this group can modify group policy for the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Enterprise Read-only Domain Controllers,CN=Users,DC=empresa,DC=test\",\"name\":\"Enterprise Read-only Domain Controllers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-498\",\"description\":\"Members of this group are Read-Only Domain Controllers in the enterprise\",\"type\":\"security\",\"scope\":\"universal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Windows Authorization Access Group,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Windows Authorization Access Group\",\"sid\":\"S-1-5-32-560\",\"description\":\"Members of this group have access to the computed tokenGroupsGlobalAndUniversal attribute on User objects\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Guests,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Guests\",\"sid\":\"S-1-5-32-546\",\"description\":\"Guests have the same access as members of the Users group by default, except for the Guest account which is further restricted\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":2},{\"dn\":\"CN=RAS and IAS Servers,CN=Users,DC=empresa,DC=test\",\"name\":\"RAS and IAS Servers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-553\",\"description\":\"Servers in this group can access remote access properties of users\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Denied RODC Password Replication Group,CN=Users,DC=empresa,DC=test\",\"name\":\"Denied RODC Password Replication Group\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-572\",\"description\":\"Members in this group cannot have their passwords replicated to any read-only domain controllers in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":8},{\"dn\":\"CN=Domain Controllers,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Controllers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-516\",\"description\":\"All domain controllers in the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Domain Guests,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Guests\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-514\",\"description\":\"All domain guests\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Distributed COM Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Distributed COM Users\",\"sid\":\"S-1-5-32-562\",\"description\":\"Members are allowed to launch, activate and use Distributed COM objects on this machine.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=IIS_IUSRS,CN=Builtin,DC=empresa,DC=test\",\"name\":\"IIS_IUSRS\",\"sid\":\"S-1-5-32-568\",\"description\":\"Built-in group used by Internet Information Services.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":1}]\n"
