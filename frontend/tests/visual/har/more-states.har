          "content": {
            "size": -1,
            "mimeType": "application/json",
            "text": "{\"messages\":{\"10 to 64\":\"10 a 64\",\"5 to 720 minutes\":\"5 a 720 minutos\",\"AD URL\":\"URL do AD\",\"CSV larger than 10 MiB\":\"CSV maior que 10 MiB\",\"FSMO Domain naming\":\"FSMO Nomes de domínio\",\"Global catalog\":\"Catálogo global\",\"HTTP log disabled (server.access_log is empty)\":\"log HTTP desligado (server.access_log vazio)\",\"OU name\":\"nome da OU\",\"access denied\":\"acesso negado\",\"access denied: domain administrators only\":\"acesso negado: apenas administradores do domínio\",\"ad.url and ad.domain are required\":\"ad.url e ad.domain são obrigatórios\",\"an object with this name already exists\":\"já existe um objeto com esse nome\",\"at most 660 × 220 px (width × height)\":\"no máximo 660 × 220 px (largura × altura)\",\"authentication\":\"autenticação\",\"built-in domain account\":\"conta interna do domínio\",\"built-in group missing at the destination\":\"grupo interno inexistente no destino\",\"changes require a TLS connection (ldaps:// or start_tls); without TLS it is read-only\":\"alterações exigem conexão com TLS (ldaps:// ou start_tls); sem TLS só leitura\",\"comment\":\"comentário\",\"company name\":\"nome da empresa\",\"company name: up to 80 characters\":\"nome da empresa: até 80 caracteres\",\"computer NetBIOS name (up to 15 characters, no spaces or dots)\":\"nome NetBIOS do computador (até 15 caracteres, sem espaço nem ponto)\",\"could not read the HTTP log\":\"não foi possível ler o log HTTP\",\"could not read the audit log\":\"não foi possível ler a auditoria\",\"deleted account ignored\":\"conta excluída ignorada\",\"deny ACE not migrated\":\"ACE de negação não migrada\",\"department\":\"departamento\",\"description\":\"descrição\",\"directory unavailable\":\"diretório indisponível\",\"domain administrators only\":\"apenas administradores do domínio\",\"domain controllers\":\"controladores de domínio\",\"domain functional level\":\"nível funcional do domínio\",\"empty password\":\"senha vazia\",\"enabled\":\"ativo\",\"enabled: no → yes\":\"ativo: não → sim\",\"enabled: yes → no\":\"ativo: sim → não\",\"enter an http(s):// URL\":\"informe uma URL http(s)://\",\"enter the agent's name and https:// URL\":\"informe nome e URL https:// do agente\",\"enter the current and the new password\":\"informe a senha atual e a nova\",\"enter the new password\":\"informe a nova senha\",\"enter the source AD URL, domain, user and password\":\"informe URL, domínio, usuário e senha do AD de origem\",\"enter the token generated by `ad-manager agent token`\":\"informe o token gerado por `ad-manager agent token`\",\"enter user and password\":\"informe usuário e senha\",\"events go to the service journal\":\"eventos vão para o journal do serviço\",\"forest functional level\":\"nível funcional da floresta\",\"full control\":\"controle total\",\"full control (users)\":\"controle total (usuários)\",\"generated password length\":\"tamanho da senha gerada\",\"generated password length: 10 to 64\":\"tamanho da senha gerada: 10 a 64\",\"give at least one read or write group or user\":\"informe ao menos um grupo ou usuário de leitura ou escrita\",\"given name\":\"primeiro nome\",\"group\":\"grupo\",\"group or member missing\":\"grupo ou membro inexistente\",\"inactive account: 7 to 3650 days\":\"conta inativa: 7 a 3650 dias\",\"invalid CSV\":\"CSV inválido\",\"invalid JSON\":\"JSON inválido\",\"invalid data\":\"dados inválidos\",\"invalid input\":\"entrada inválida\",\"invalid log file\":\"arquivo de log inválido\",\"invalid or expired link\":\"link inválido ou expirado\",\"invalid request body\":\"corpo inválido\",\"invalid response from the agent\":\"resposta inválida do agente\",\"invalid token\":\"token inválido\",\"invalid user or password\":\"usuário ou senha inválidos\",\"invalid validity\":\"validade inválida\",\"language: pt-BR or en\":\"idioma: pt-BR ou en\",\"local database (db.path) not configured\":\"banco local (db.path) não configurado\",\"local database disabled ([db] path)\":\"banco local desativado ([db] path)\",\"login and name are required; login without spaces or \\\"/\\\\[]:;|=,+*?\\u003c\\u003e\":\"login e nome são obrigatórios; login sem espaços nem \\\"/\\\\[]:;|=,+*?\\u003c\\u003e\",\"logo: at most 660 × 220 px (width × height)\":\"logo: no máximo 660 × 220 px (largura × altura)\",\"logo: send PNG, JPEG or SVG (no scripts)\":\"logo: envie PNG, JPEG ou SVG (sem scripts)\",\"logo: up to 512 KiB\":\"logo: até 512 KiB\",\"name\":\"nome\",\"no → yes\":\"não → sim\",\"not found\":\"não encontrado\",\"object not found\":\"objeto não encontrado\",\"operation refused\":\"operação recusada\",\"path\":\"caminho\",\"phone\":\"telefone\",\"please sign in\":\"faça login\",\"protected system object\":\"objeto protegido do sistema\",\"protected system object: operation refused\":\"objeto protegido do sistema: operação recusada\",\"queue unavailable\":\"fila indisponível\",\"queued\":\"na fila\",\"read\":\"leitura\",\"read (users)\":\"leitura (usuários)\",\"record not found\":\"registro não encontrado\",\"same as on the server\":\"igual ao servidor\",\"send PNG, JPEG or SVG (no scripts)\":\"envie PNG, JPEG ou SVG (sem scripts)\",\"send compartilhamentos.csv\":\"envie compartilhamentos.csv\",\"send the logo file\":\"envie o arquivo do logo\",\"server not registered\":\"servidor não cadastrado\",\"session expired\":\"sessão expirada\",\"session time\":\"tempo de sessão\",\"session time: 5 to 720 minutes\":\"tempo de sessão: 5 a 720 minutos\",\"set agent.cert_file/key_file or self_signed = true (HTTP only with --insecure-dev on loopback)\":\"configure agent.cert_file/key_file ou self_signed = true (HTTP só com --insecure-dev em loopback)\",\"set server.cert_file/key_file or self_signed = true, or listen on 127.0.0.1 behind a TLS proxy (trust_proxy = true); for local development use --insecure-dev\":\"configure server.cert_file/key_file ou self_signed = true, ou escute em 127.0.0.1 atrás de proxy TLS (trust_proxy = true); para desenvolvimento local use --insecure-dev\",\"skipped\":\"ignorado\",\"source AD\":\"AD de origem\",\"support link\":\"link de suporte\",\"support link: enter an http(s):// URL\":\"link de suporte: informe uma URL http(s)://\",\"surname\":\"sobrenome\",\"the OU is not empty\":\"a OU não está vazia\",\"the account changed after it was generated\":\"a conta foi alterada depois que ele foi gerado\",\"the agent needs [redis] addr\":\"o agente precisa de [redis] addr\",\"the agent requires HTTPS\":\"o agente exige HTTPS\",\"the agent requires HTTPS: set agent.cert_file/key_file or self_signed = true (HTTP only with --insecure-dev on loopback)\":\"o agente exige HTTPS: configure agent.cert_file/key_file ou self_signed = true (HTTP só com --insecure-dev em loopback)\",\"the audit log has no file (server.audit_log is empty)\":\"auditoria sem arquivo (server.audit_log vazio)\",\"the audit log has no file (server.audit_log is empty): events go to the service journal\":\"auditoria sem arquivo (server.audit_log vazio): eventos vão para o journal do serviço\",\"the link is no longer valid\":\"o link não vale mais\",\"the link is no longer valid: the account changed after it was generated\":\"o link não vale mais: a conta foi alterada depois que ele foi gerado\",\"the panel requires HTTPS\":\"o painel exige HTTPS\",\"the panel requires HTTPS: set server.cert_file/key_file or self_signed = true, or listen on 127.0.0.1 behind a TLS proxy (trust_proxy = true); for local development use --insecure-dev\":\"o painel exige HTTPS: configure server.cert_file/key_file ou self_signed = true, ou escute em 127.0.0.1 atrás de proxy TLS (trust_proxy = true); para desenvolvimento local use --insecure-dev\",\"the password does not meet the domain policy\":\"a senha não atende à política do domínio\",\"the shares agent only works on Linux\":\"o agente de compartilhamentos só funciona em Linux\",\"this link was already opened in another browser; ask the administrator for a new one\":\"este link já foi aberto em outro navegador; peça um novo ao administrador\",\"title\":\"cargo\",\"too many attempts; wait a few minutes\":\"muitas tentativas; aguarde alguns minutos\",\"up to 512 KiB\":\"até 512 KiB\",\"up to 80 characters\":\"até 80 caracteres\",\"user\":\"usuário\",\"values out of range (history 0-24, minimum age \\u003c maximum age, window ≤ lockout duration)\":\"valores fora do intervalo (histórico 0-24, idade mínima \\u003c máxima, janela ≤ duração do bloqueio)\",\"write\":\"escrita\",\"write (users)\":\"escrita (usuários)\",\"yes → no\":\"sim → não\"},\"patterns\":[[\"^theme: (.+) or ([^ ]+)$\",\"tema: $1 ou $2\"],[\"^connect to (\\\\S+)$\",\"conectar em $1\"],[\"^administrative group (\\\"[^\\\"]*\\\")$\",\"grupo administrativo $1\"],[\"^member of (.+)$\",\"membro de $1\"],[\"^member ([^:]+)$\",\"membro $1\"],[\"^group ([^:]+) not resolved by winbind$\",\"grupo $1 não resolvido pelo winbind\"],[\"^group ([^:]+)$\",\"grupo $1\"],[\"^(.+) in ((?:OU|CN)=[^:]*)$\",\"$1 em $2\"],[\"^code ([0-9]+)$\",\"código $1\"],[\"^reply of ([0-9]+) bytes$\",\"resposta de $1 bytes\"],[\"^user only in ([^:]+)$\",\"usuário só em $1\"],[\"^group only in ([^:]+)$\",\"grupo só em $1\"],[\"^member of (.+) only in ([^:]+)$\",\"membro de $1 só em $2\"],[\"^(.+) only in ([^:]+)$\",\"$1 só em $2\"],[\"^(.+) does not contain a valid hash$\",\"$1 não contém um hash válido\"],[\"^task type (.+)$\",\"tipo de tarefa $1\"],[\"^agent token \\\\((.+)\\\\)$\",\"token do agente ($1)\"],[\"^server ([^:]+) unavailable$\",\"servidor $1 indisponível\"],[\"^default OU must be inside (.+)$\",\"OU padrão precisa estar dentro de $1\"],[\"^share name (.+) \\\\(letters, numbers, space \\\\. _ -; reserved: (.+)\\\\)$\",\"nome de compartilhamento $1 (letras, números, espaço . _ -; reservados: $2)\"],[\"^(\\\".*\\\") is outside the allowed roots (.+)$\",\"$1 fora das raízes permitidas $2\"],[\"^(\\\".*\\\") is a symbolic link$\",\"$1 é link simbólico\"],[\"^the folder (.+) does not exist \\\\(check \\\"create folder\\\"\\\\)$\",\"a pasta $1 não existe (marque criar pasta)\"],[\"^([^:]+) is not a regular folder$\",\"$1 não é uma pasta comum\"],[\"^(.+) changed during creation \\\\(now (.+)\\\\)$\",\"$1 mudou durante a criação (agora $2)\"],[\"^missing column (.+) \\\\(expected: (.+)\\\\)$\",\"falta a coluna $1 (esperado: $2)\"],[\"^unexpected output (.+)$\",\"saída inesperada $1\"],[\"^invalid gid (.+)$\",\"gid inválido $1\"],[\"^self-signed certificate in (.+)$\",\"certificado auto-assinado em $1\"],[\"^permission of (.+)$\",\"permissão de $1\"],[\"^NTFS ACL of (.+)$\",\"ACL NTFS de $1\"],[\"^queued \\\\((.+)\\\\)$\",\"na fila ($1)\"]]}\n"
