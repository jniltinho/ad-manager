ss as members of the Users group by default, except for the Guest account which is further restricted\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":2},{\"dn\":\"CN=RAS and IAS Servers,CN=Users,DC=empresa,DC=test\",\"name\":\"RAS and IAS Servers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-553\",\"description\":\"Servers in this group can access remote access properties of users\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Denied RODC Password Replication Group,CN=Users,DC=empresa,DC=test\",\"name\":\"Denied RODC Password Replication Group\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-572\",\"description\":\"Members in this group cannot have their passwords replicated to any read-only domain controllers in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":8},{\"dn\":\"CN=Domain Controllers,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Controllers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-516\",\"description\":\"All domain controllers in the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Domain Guests,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Guests\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-514\",\"description\":\"All domain guests\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Distributed COM Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Distributed COM Users\",\"sid\":\"S-1-5-32-562\",\"description\":\"Members are allowed to launch, activate and use Distributed COM objects on this machine.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=IIS_IUSRS,CN=Builtin,DC=empresa,DC=test\",\"name\":\"IIS_IUSRS\",\"sid\":\"S-1-5-32-568\",\"description\":\"Built-in group used by Internet Information Services.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":1}]\n"
