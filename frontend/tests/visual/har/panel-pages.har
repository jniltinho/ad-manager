          "content": {
            "size": -1,
            "mimeType": "application/json",
            "text": "[{\"dn\":\"CN=Remote Desktop Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Remote Desktop Users\",\"sid\":\"S-1-5-32-555\",\"description\":\"Members in this group are granted the right to logon remotely\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Performance Log Users,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Performance Log Users\",\"sid\":\"S-1-5-32-559\",\"description\":\"Members of this group may schedule logging of performance counters, enable trace providers, and collect event traces both locally and via remote access to this computer\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Suporte,CN=Users,DC=empresa,DC=test\",\"name\":\"Suporte\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1118\",\"description\":\"Equipe Suporte\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":2},{\"dn\":\"CN=Domain Users,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Users\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-513\",\"description\":\"All domain users\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Protected Users,CN=Users,DC=empresa,DC=test\",\"name\":\"Protected Users\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-525\",\"description\":\"Members of this group are afforded additional protections against authentication security threats\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Cryptographic Operators,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Cryptographic Operators\",\"sid\":\"S-1-5-32-569\",\"description\":\"Members are authorized to perform cryptographic operations.\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Design,CN=Users,DC=empresa,DC=test\",\"name\":\"Design\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1119\",\"description\":\"Equipe Design\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Diretoria,CN=Users,DC=empresa,DC=test\",\"name\":\"Diretoria\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1117\",\"description\":\"Equipe Diretoria\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":1},{\"dn\":\"CN=Pre-Windows 2000 Compatible Access,CN=Builtin,DC=empresa,DC=test\",\"name\":\"Pre-Windows 2000 Compatible Access\",\"sid\":\"S-1-5-32-554\",\"description\":\"A backward compatibility group which allows read access on all users and groups in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":1},{\"dn\":\"CN=DnsUpdateProxy,CN=Users,DC=empresa,DC=test\",\"name\":\"DnsUpdateProxy\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-1102\",\"description\":\"DNS clients who are permitted to perform dynamic updates on behalf of some other clients (such as DHCP servers).\",\"type\":\"security\",\"scope\":\"global\",\"protected\":false,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Allowed RODC Password Replication Group,CN=Users,DC=empresa,DC=test\",\"name\":\"Allowed RODC Password Replication Group\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-571\",\"description\":\"Members in this group can have their passwords replicated to all read-only domain controllers in the domain\",\"type\":\"security\",\"scope\":\"domainlocal\",\"protected\":true,\"members\":null,\"member_count\":0},{\"dn\":\"CN=Domain Computers,CN=Users,DC=empresa,DC=test\",\"name\":\"Domain Computers\",\"sid\":\"S-1-5-21-1024246598-1679293832-1896568812-515\",\"description\":\"All workstations and servers joined to the domain\",\"type\":\"security\",\"scope\":\"global\",\"protected\":true,\"members\":null,\"member_count\":0},